# Working notes for the hardening plan: scratch, like PLAN.md itself.
.testfortress/phase-logs/

# Local gate surface scratch output (reports are regenerated on every run).
# The directory's CONTENTS are ignored rather than the directory itself: git
# cannot re-include a file underneath an excluded directory, so `.gitkeep` would
# be unreachable behind a `.testfortress/reports/` rule and a fresh clone would
# have no directory for the runner to write into.
.testfortress/reports/*
!.testfortress/reports/.gitkeep

# Mutation testing scratch (scripts/ci/mutation-gate.mjs): Stryker's sandbox
# copies of the whole checkout, its per-leg incremental state and its per-leg
# JSON reports. Regenerated on demand, hundreds of MB, and specific to one
# machine. It MUST be ignored rather than merely uncommitted: the sandbox is a
# copy of the repository, so an untracked one would be scanned twice by
# `audit:secrets` and `audit:integrity`, and would make every report in
# `.testfortress/reports` look stale.
.stryker-tmp/

# Temporary backup copies created while editing (never commit)
*.tmp
