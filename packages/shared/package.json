{
  "name": "@hvault/shared",
  "version": "0.14.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/inject-version.js && tsc",
    "dev": "tsc --watch",
    "test": "vitest run --coverage",
    "test:flake": "vitest run --config vitest.flake.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile ../../.cache/tsbuildinfo/shared.src.tsbuildinfo && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.2",
    "vitest": "^4.1.11"
  }
}
