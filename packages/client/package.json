  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:flake": "vitest run --config vitest.flake.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "test:fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:upgrade": "vitest run --config vitest.upgrade.config.ts",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile ../../.cache/tsbuildinfo/client.src.tsbuildinfo && tsc -p tsconfig.test.json"
  },
