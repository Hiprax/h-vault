    "otpauth": "^9.5.2",
    "prettier": "^3.9.6",
    "qr": "^0.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
