// Type-checking for this package's TESTS. See
// `packages/shared/tsconfig.test.json` for why this is a separate config and why
// its strictness is inherited rather than relaxed.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // The repo root, not `.`: `rootDir` is a pure CONSTRAINT under `noEmit`, and
    // `tests/determinism.ts` re-exports the repo-wide determinism harness in
    // `tests/harness/`, which every package's suite must pin identically. Same
    // reasoning as `packages/server/tsconfig.test.json`.
    "rootDir": "../..",
    // `node` on top of the build config's list: tests run under Vitest, so they
    // reach for `process.env`, `node:crypto` and Node's timer types. It is added
    // ONLY here — `src/` stays browser-typed, so a Node-only global cannot slip
    // into shipped code without the build type-check catching it.
    "types": ["vite/client", "vite-plugin-pwa/react", "node"],
    // `tests/vite-config.test.ts` reads the bundle gate's OWN budget table out of
    // the repo-root `scripts/ci/lib/bundle-budgets.mjs`, so the sandbox build's
    // size advisory and the ceiling the gate enforces cannot drift into naming
    // two different numbers. Letting TS INFER that module's types from the real
    // source beats a hand-written `.d.mts` sidecar, which would be free to drift
    // from the module it describes without anything noticing — the same call
    // `packages/server/tsconfig.test.json` already makes for the same directory.
    // `checkJs` stays off (its default), so this only teaches the resolver to
    // read those files; it relaxes nothing about the TypeScript it checks, and
    // `src/` is unaffected because the build config does not set it.
    "allowJs": true,
    // Its own build info, never the build config's and never shared with another
    // project: see `packages/shared/tsconfig.test.json` for both rules and why the
    // configs that EMIT must not carry these two keys.
    "incremental": true,
    "tsBuildInfoFile": "../../.cache/tsbuildinfo/client.tests.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "*.config.ts",
    "vite.config.helpers.ts",
    // `*.config.ts` does NOT match this name (it ends `.sandbox.ts`), and the
    // sandbox build config would otherwise be type-checked only as a side effect
    // of `tests/vite-config.test.ts` importing it.
    "vite.config.sandbox.ts",
    "scripts/**/*"
  ],
  "references": [{ "path": "../shared" }]
}
