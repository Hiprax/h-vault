# =============================================================================
# H-Vault — configuration
# =============================================================================
# Copy to `.env` and fill in the values below:  cp .env.example .env
#
# This ONE file configures everything. There is no per-package .env: the Docker
# stack hands this whole file to the app container (`env_file: .env` in
# docker-compose.yml), and outside Docker the server resolves it from the monorepo
# root. Compose also reads it for its own ${...} substitutions (the published port,
# the MongoDB credentials).
#
# A handful of keys below are IGNORED when running under Docker Compose, because
# the container topology fixes them and .env cannot know them. Compose overrides
# each one, and every such key is marked "[docker: overridden]" here:
#
#     NODE_ENV        -> always production in the stack
#     PORT            -> always 5000 inside the app container (never published)
#     MONGODB_URI     -> always points at the in-stack `hvault-db` replica set
#     TRUST_PROXY     -> set from TRUST_PROXY_HOPS (see below)
#     S3_ENDPOINT     -> always points at the in-stack `hvault-s3` storage engine
#     S3_RPC_SECRET   -> blanked in the app container; only hvault-s3 reads it
#
# Generate every secret with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# -----------------------------------------------------------------------------
# Docker Compose  (only read when deploying with `docker compose up`)
# -----------------------------------------------------------------------------
# The ONE host port the whole stack publishes, bound to 127.0.0.1. Your system
# Nginx terminates TLS and proxies to it — see docker/nginx/system.docker.example.conf,
# and keep its `proxy_pass` in sync with whatever you set here.
#
# If this host runs more than one of these stacks, EVERY stack needs its own port
# (they all bind 127.0.0.1, so a duplicate is a bind conflict), its own subnets
# (below), and its own HVAULT_STACK_NAME (immediately below).
HVAULT_HTTP_PORT=8080

# Namespaces the whole stack: the Compose project, and with it every container,
# network and volume name. Leave it alone unless this host runs a SECOND H-Vault —
# in which case give that one its own name, because two stacks sharing a project name
# do not fail loudly. Compose considers them the same project, so the second `up`
# recreates the first one's containers and adopts its volumes.
HVAULT_STACK_NAME=hvault

# How many reverse proxies sit in front of Express. This MUST match reality exactly:
# Express trusts the last N entries of X-Forwarded-For, so too high lets a client
# spoof its own IP (defeating the IP-keyed rate limits and poisoning the audit log),
# and too low attributes every request to the proxy.
#   2 = your system Nginx + the stack's internal Nginx   <- the documented setup
#   1 = you expose 127.0.0.1:${HVAULT_HTTP_PORT} directly, with no system Nginx
TRUST_PROXY_HOPS=2

# The two bridge subnets the stack pins (edge = Nginx <-> app + the app's egress;
# data = app <-> MongoDB and the object storage engine, with no route off the
# host). They are pinned so the addresses cannot drift with whatever else exists
# on the host that day.
#
# Change them if 172.31.24x is already taken here — a collision is not a warning:
# Docker refuses to create the network ("Pool overlaps with other one on this
# address space") and the stack will not start. `docker network ls` and
# `docker network inspect <name>` show what is in use. Keep the two distinct.
HVAULT_EDGE_SUBNET=172.31.240.0/24
HVAULT_DATA_SUBNET=172.31.241.0/24

# The tag the stack's own images are built and run under. Keep it equal to the
# `version` in package.json (a unit test asserts the compose default does), so a
# rollback is `git checkout v<previous> && docker compose up -d --build`: the old
# release's images are still on the host under their own tag, and `docker compose
# ps` says out loud which release is serving.
HVAULT_VERSION=0.13.0

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000                              # [docker: overridden -> 5000, unpublished]
NODE_ENV=development                   # [docker: overridden -> production]

# NOTE: the Vite dev server's port (local `npm run dev` + the Playwright E2E probe)
# is NOT configured here. Vite does not read this root .env into its process
# environment, so a value set here would silently not apply. It defaults to 5173
# and is overridden through the PROCESS environment instead:
#   VITE_PORT=5180 npm run dev        (docker-compose.dev.yml sets it via environment:)
# It is deliberately not 3000 — Windows reserves dynamic TCP ranges that routinely
# include it, and a reserved port fails to bind with EACCES. Production is
# unaffected: the built SPA is served by Nginx, not Vite.
APP_NAME=H-Vault

# ---- CHANGE THESE TWO TO YOUR OWN DOMAIN BEFORE DEPLOYING --------------------
# Your public URL. It goes into the links H-Vault emails (verification, password
# reset, account unlock), so it must be an address a user's browser can reach.
APP_URL=https://vault.example.com

# Browser origin allowed to call the API. In production the app REFUSES TO BOOT
# unless this is https:// — deliberately, so a misconfigured deployment fails loudly
# instead of quietly running with a permissive origin. Behind the single-port stack
# the SPA and the API share an origin, so this is simply your public URL again.
#
# The https:// default above is correct for BOTH modes, which is why it is not the
# localhost value you might expect: under Docker, Compose pins NODE_ENV=production,
# so an http:// value here is a hard boot failure; and for local `npm run dev` this
# value is never exercised, because the Vite dev server proxies /api to Express
# same-origin and the browser therefore performs no CORS check at all.
CORS_ORIGIN=https://vault.example.com

# How long the server will spend RECEIVING one request, and its headers, in
# milliseconds. Both are applied to the HTTP server at boot; neither may be zero,
# so the protection cannot be turned off from here, and the headers value must
# never exceed the request value (the server refuses to boot if it does).
#
# 240 s is the largest body any route accepts — a 30 MB backup restore or key
# rotation — at 128 KiB/s, which is the slowest sustained uplink this deployment
# stands behind. Lower it only if you know none of your users restore a large
# backup over a slow link. It bounds RECEIVING a request, never handling one: a
# rotation or restore that takes minutes of server time is unaffected.
#
# The document part route does NOT wait this long. It carries its own, tighter
# body deadline, DOCUMENT_PART_BODY_TIMEOUT_MS below, because a part upload holds
# one of the server's four in-flight slots from before its body is read, and that
# deadline is what bounds how long one account can keep a slot from everybody else.
# Lowering this below that part deadline (64000 by default) refuses to boot too,
# so lower DOCUMENT_PART_BODY_TIMEOUT_MS with it.
HTTP_REQUEST_TIMEOUT_MS=240000
HTTP_HEADERS_TIMEOUT_MS=60000

# How long ONE 8 MiB document part may take to arrive, in milliseconds (5000 to
# 600000, and never more than HTTP_REQUEST_TIMEOUT_MS or the server refuses to
# boot). The default, 64 s, is one part at 128 KiB/s, and that is a minimum upload
# speed PER FILE: a user uploading three files at once shares one connection
# between them and needs about three times that. A part that has not fully arrived
# in time is dropped and retried, and after three tries the upload fails. Raise it
# if your users upload documents over slow links; the cost is that one account can
# then hold an upload slot for longer with a body it never sends.
DOCUMENT_PART_BODY_TIMEOUT_MS=64000

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
# Local (non-Docker) connection string.        [docker: overridden -> hvault-db/rs0]
MONGODB_URI=mongodb://localhost:27017/hvault

# Credentials for the database INSIDE the Docker stack. Compose creates the root
# user from these on first boot and interpolates them into the app's MONGODB_URI.
#
# IMPORTANT: the password is embedded in a connection URI, so keep it URL-SAFE.
# A raw '@', ':', '/', '?' or '#' would be parsed as URI syntax and the app would
# fail to connect. Generate it with:  openssl rand -hex 32
#
# Also note it is only applied on the FIRST boot against an empty data directory —
# changing it later does not rotate the existing user (see the README's
# troubleshooting table for how to rotate it properly).
#
# It is deliberately left EMPTY here rather than carrying a placeholder value. A
# placeholder is a working password: `cp .env.example .env`, fill in the secrets that
# shout at you, and you would be running a password manager whose database root
# credential is a literal published in this repository — with nothing to tell you.
# Empty fails closed instead: `docker compose up` stops immediately with
# "MONGO_ROOT_PASSWORD is required" (the `:?` guard in docker-compose.yml), because
# `${VAR:?}` rejects an empty value exactly as it rejects a missing one.
MONGO_ROOT_USERNAME=hvault
MONGO_ROOT_PASSWORD=

# ---- Application database user (least privilege) ----------------------------
# The app and the index bootstrap authenticate as THIS user, never as root. It is
# created inside the `hvault` database with the built-in `readWrite` role on
# `hvault` and nothing else: no `admin` database, no cluster privileges, no second
# database. Root is held by exactly two containers — hvault-db itself, and the
# one-shot hvault-db-init that provisions this user.
#
# URL-SAFE, for the same reason as the root password (it is interpolated into a
# connection URI):  openssl rand -hex 32
#
# Empty fails closed, exactly like MONGO_ROOT_PASSWORD above.
#
# hvault-db-init creates the user on the first `up`; on every later `up` it
# reconciles only the ROLES and never rewrites the password, so a password rotated
# inside the database survives a redeploy. The corollary: changing the value here
# alone does NOT re-sync it — rotate inside the database first (see the README's
# secret-rotation table), then update this file.
MONGO_APP_USERNAME=hvault_app
MONGO_APP_PASSWORD=

MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# -----------------------------------------------------------------------------
# JWT — minimum 32 characters each, and they must differ from one another
# -----------------------------------------------------------------------------
# The placeholders below deliberately start with `dev-`, which the server REFUSES
# to boot with outside development. That is the point: `cp .env.example .env` and
# forgetting to change them would otherwise run a password manager on signing keys
# that are published in this repository, and nothing else would complain — they are
# over 32 characters, so validation alone would pass them.
JWT_ACCESS_SECRET=dev-replace-with-unique-access-token-secret-at-least-32-chars
JWT_REFRESH_SECRET=dev-replace-with-different-refresh-token-secret-at-least-32-chars
JWT_ACCESS_EXPIRY=5m

# Session lifetimes, in whole days. The defaults reproduce the historical 7-day
# refresh horizon exactly. REFRESH_TOKEN_REMEMBER_DAYS must be >= REFRESH_TOKEN_DAYS
# and TRUSTED_DEVICE_DAYS must be >= REFRESH_TOKEN_REMEMBER_DAYS, or the server
# refuses to boot.
REFRESH_TOKEN_DAYS=7             # standard session length (int 1-90)
REFRESH_TOKEN_REMEMBER_DAYS=30   # "remember me" session length (int 1-365)
TRUSTED_DEVICE_DAYS=30           # how long a device may skip 2FA (int 1-365)

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# Minimum 32 characters. Signs the CSRF double-submit token.
SESSION_SECRET=dev-replace-me-with-secure-random-32-chars

# Optional (min 32 chars). Encrypts the stored 2FA TOTP secrets. Falls back to
# SESSION_SECRET; set a dedicated key in production so the CSRF and 2FA keys are
# separated.
# TWO_FACTOR_ENCRYPTION_KEY=

# Reverse-proxy hop count for Express. Leave EMPTY outside Docker unless you run
# behind a proxy; under Docker it is set from TRUST_PROXY_HOPS above.
# TRUST_PROXY=                         # [docker: overridden -> TRUST_PROXY_HOPS]

# Rate limiting is not configurable by environment, by design. Every tier carries
# its own window and ceiling, each sized against the specific traffic it bounds —
# see the table in README.md. (`RATE_LIMIT_WINDOW_MS` / `RATE_LIMIT_MAX` used to be
# documented here and were read by nothing; if you have them in an existing .env
# you can delete them, they are ignored.)

# -----------------------------------------------------------------------------
# Email — required for verification, password reset, account unlock and backups
# -----------------------------------------------------------------------------
# Provider: "smtp" (default) or "gmail".
EMAIL_PROVIDER=smtp

# SMTP. All three of HOST/USER/PASS must be set together, or all left empty —
# a partial configuration is an error in production and a warning in development.
SMTP_HOST=
SMTP_PORT=587
# Leave empty to auto-detect TLS (true for port 465, false otherwise).
# SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hvault.local

# Gmail (EMAIL_PROVIDER=gmail). Use an App Password, not your account password:
# https://myaccount.google.com/apppasswords . Both must be set, or neither.
# GMAIL_USERNAME=
# GMAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Backup / export
# -----------------------------------------------------------------------------
BACKUP_MAX_SIZE_MB=25
BACKUP_RETENTION_DAYS=30
EXPORT_MAX_SIZE_MB=25

# -----------------------------------------------------------------------------
# File Encryption tool
# -----------------------------------------------------------------------------
# Client-side size guardrail (MB, 1-1024) for the standalone File Encryption tool.
# The file is encrypted entirely in the browser and NEVER uploaded, so the server
# cannot enforce this — it is advertised to the client via GET /api/v1/config.
FILE_ENCRYPTION_MAX_SIZE_MB=100

# -----------------------------------------------------------------------------
# Document store (object storage) — OPTIONAL, and OFF unless configured
# -----------------------------------------------------------------------------
# Encrypted document storage is off unless ALL FOUR connection variables below are
# set. Leave them empty and the APPLICATION changes nothing: the API reports the
# feature as unavailable and the app hides it. A PARTIAL configuration is refused
# rather than half-applied: the server fails to boot in production, and warns and
# disables the feature in development. Same rule as SMTP above, for the same reason.
#
# THE DOCKER STACK IS THE EXCEPTION, and it is not subtle: docker-compose.yml runs
# the storage engine as a service of its own (`hvault-s3`) and interpolates
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and S3_RPC_SECRET with `${...:?}`
# guards, exactly as it does the database passwords. Compose refuses to resolve the
# stack when any of those four is missing OR empty, so `docker compose up` stops —
# before a single container is created, naming the variable — until you fill them
# in. Under pm2, or any deployment that is not this Compose stack, there is no
# storage engine and leaving them empty is the supported way to run without
# documents. S3_ENDPOINT is the one connection variable the Compose stack sets for
# you (`http://hvault-s3:3900`, the in-stack service), because it is container
# topology rather than operator configuration.
#
# Documents are encrypted in the browser before a byte leaves the machine, so the
# storage service only ever holds ciphertext, a wrapped key and byte counts. It
# never sees a filename, a MIME type, a tag, a note or any content.
#
# Any S3-compatible service works, self-hosted or hosted.
#
# In PRODUCTION a plain http:// endpoint is accepted only when it points at a host
# the traffic never leaves: a loopback address, an RFC 1918 private address, or a
# single-label host such as an in-stack service name. Anything else must be
# https://, or the bucket credentials and every ciphertext byte cross a network in
# the clear.
#
# LEAVE S3_ENDPOINT EMPTY when you run the Docker stack: it pins the in-stack
# address itself and a value here is ignored. Set it only for a deployment that
# points at storage of its own (pm2, or an external S3 service).
S3_ENDPOINT=
# Must match the storage engine's own region. The Docker stack's engine is
# configured in docker/garage/garage.toml, whose `s3_region` is us-east-1, so the
# default works untouched; SigV4 signs the region, so a mismatch fails every
# request against your own bucket with a signature error.
S3_REGION=us-east-1
# The bucket that holds the encrypted documents. In the Docker stack this is also
# the bucket the storage engine CREATES on first boot, and `docker compose up`
# refuses to resolve while it is empty. Because it is created rather than looked
# up, it must be a VALID S3 bucket name (3-63 characters, lower case, no leading
# or trailing dash) or the storage container exits 1 with "Invalid default bucket
# name" and, under its restart policy, crash-loops.
S3_BUCKET=

# Bucket credentials. The access key id must be at least 8 characters and the
# secret at least 16. Generate the secret with:  openssl rand -hex 32
#
# Left EMPTY here on purpose, exactly like the database passwords above: a
# placeholder is a working credential, and one published in this repository would
# be a working credential for your bucket with nothing to tell you.
#
# Rotating them: change the ID AND the secret together. A self-hosted engine that
# already knows this access key id with a different secret refuses to start rather
# than adopting the new one, so changing the secret alone leaves the storage
# service crash-looping. Measured against the pinned engine: it exits 1 with
# "Access key <id> is associated with a secret key different than the one given in
# GARAGE_DEFAULT_SECRET_KEY". See the secret-rotation table in README.md.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Path-style addressing (bucket in the URL path). Defaults to true, which is what
# an in-stack or self-hosted service needs; virtual-host style puts the bucket in
# the hostname and needs DNS for it. Only the exact value `false` turns it off.
# S3_FORCE_PATH_STYLE=true

# NOT read by the application. This is the storage engine's own cluster RPC
# secret, consumed by the storage container in the Docker stack, which is why it
# is not validated at app boot and why the app's `environment:` block blanks it
# back out. The Docker stack still refuses to start without it. Generate it with:
#   openssl rand -hex 32
S3_RPC_SECRET=

# Largest single document a client may upload, in MB (1-1024).
MAX_DOCUMENT_SIZE_MB=100
# Per-user storage quota, in MB (1-1048576). It counts stored documents plus the
# declared size of uploads still in flight, and it must be at least
# MAX_DOCUMENT_SIZE_MB, or the server refuses to boot: a quota below the size cap
# would accept an upload at the door and refuse it at the quota check every time.
DOCUMENT_STORAGE_QUOTA_MB_PER_USER=2048
# How long an unfinished upload is kept before it is abandoned, in hours (1-168).
DOCUMENT_UPLOAD_TTL_HOURS=24
# Optional comma-separated extension allowlist, e.g. `pdf,md,png`. Empty means
# every type is allowed. It is ADVISORY and enforced in the browser only: the
# server receives ciphertext and cannot see a filename, so it cannot enforce this
# and no configuration here restricts what actually reaches the bucket.
DOCUMENT_ALLOWED_EXTENSIONS=

# -----------------------------------------------------------------------------
# Audit
# -----------------------------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Where the rotating log files are written. Unset, they land in `logs/` beside
# whatever directory the process was started from, which differs between `npm
# start` at the repo root, a workspace-scoped script and the container image.
# Set it explicitly to put them on a mounted volume. Relative values resolve
# against the working directory; a blank value is treated as unset. Under
# NODE_ENV=test no file transports are attached at all, so a test run writes no
# log files anywhere.
# LOG_DIRECTORY=/var/log/hvault

# -----------------------------------------------------------------------------
# Breach range cache (persistent, cross-account HIBP Pwned Passwords cache)
# -----------------------------------------------------------------------------
# On-demand (source=hibp) cache entries are re-fetched once older than this many
# days; seed-imported entries are exempt (refreshed by re-running the seed). The
# HIBP corpus is additive, so a stale entry can only miss a very recently added
# breach, never wrongly clear one — set 7 for a stricter freshness posture.
BREACH_CACHE_TTL_DAYS=30
# When true, the optional refresh cron below fetches missing/stale ranges from
# HIBP (tens of GB over a full corpus). Off by default.
BREACH_SEED_AUTO=false
# Cron expression (UTC) for the breach-range refresh job. Unset disables it.
# Requires BREACH_SEED_AUTO=true to actually fetch. To pre-seed the full corpus
# once (offline / zero-third-party-dependency), run locally:
#   npm run seed-breaches -w packages/server
# or, inside the production Docker image (which has no npm or tsx):
#   docker compose exec hvault-app node packages/server/dist/cli/seedBreaches.js
BREACH_SEED_REFRESH_CRON=
# In-memory (L1) HIBP range cache ceiling, in bytes, PER worker process. A real HIBP
# range is ~36 KB, so the default 64 MiB bounds the cache at ~1,800 ranges. This byte
# budget is the binding memory bound for the breach cache; the 10,000-entry cap is a
# secondary guard. Minimum 1 MiB (1048576).
HIBP_CACHE_MAX_BYTES=67108864

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Swagger UI (/api/docs) and the OpenAPI document (/api/v1/docs.json). Served
# automatically in development and test. Enabling it in production exposes
# UNAUTHENTICATED API docs — leave it off unless you mean it.
# ENABLE_SWAGGER=false

# Metrics endpoint token (min 16 chars). When set, GET /api/v1/metrics is exposed
# and requires a matching `x-metrics-token` header. Unset, the endpoint 404s.
# METRICS_TOKEN=
