# Auto-detect text files and ensure LF line endings
* text=auto eol=lf

# Explicit text files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.sh text eol=lf

# Docker. LF is not cosmetic here: keyfile-entrypoint.sh runs as the MongoDB
# container's ENTRYPOINT, and a CRLF line ending would make the kernel look for an
# interpreter literally named "/usr/bin/env bash" — the container would never boot.
Dockerfile text eol=lf
*.Dockerfile text eol=lf
.dockerignore text eol=lf
*.conf text eol=lf

# Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar.gz binary

# Byte-exact test fixtures - NEVER normalize.
#
# The blanket `* text=auto eol=lf` at the top of this file is the reason these
# rules exist rather than being obvious. All four directories hold files whose
# BYTES are the thing under test:
#
#   - the export goldens are CRLF-terminated because RFC 4180 mandates CRLF and
#     that is what Bitwarden and Chrome actually receive. Normalized to LF they
#     would still compare equal to a serializer that had switched to LF, so the
#     line ending would silently stop being pinned - and on a fresh clone they
#     would differ from the serializer's real output and fail for the wrong
#     reason;
#   - the format-and-repair corpus carries CRLF-terminated JSON Lines and a
#     UTF-16LE document, both of which the blanket rule would destroy;
#   - the fuzz corpus carries a deliberate mixture of CRLF, LF and bare CR,
#     plus a UTF-8 BOM, precisely to prove the CSV tokenizer handles all of
#     them. Normalizing it deletes the test;
#   - the end-to-end document fixtures are uploaded, encrypted, stored, read
#     back and compared BYTE FOR BYTE against the file on disk, which is the
#     whole point of that journey. A line ending git rewrote on checkout would
#     make the comparison fail on a fresh clone, and it would simply corrupt
#     checker.png and handbook.pdf.
#
# `-text` (rather than `text eol=crlf`) because the point is that git must not
# touch these bytes in either direction.
packages/client/tests/export/goldens/** -text
packages/client/tests/fuzz/corpus/** -text
packages/client/tests/fuzz/format-corpus/** -text
e2e/fixtures/** -text

# Lockfiles - exact (no diff noise)
package-lock.json -diff linguist-generated=true
