{
  "name": "hvault",
  "version": "0.14.0",
  "private": true,
  "description": "Zero-knowledge password manager, secret store, and encrypted note-taking application",
  "license": "MIT",
  "author": "Hiprax",
  "homepage": "https://github.com/Hiprax/h-vault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiprax/h-vault.git"
  },
  "bugs": {
    "url": "https://github.com/Hiprax/h-vault/issues"
  },
  "keywords": [
    "password-manager",
    "zero-knowledge",
    "end-to-end-encryption",
    "self-hosted",
    "secret-store",
    "encrypted-notes",
    "aes-256-gcm",
    "web-crypto-api",
    "mern",
    "typescript"
  ],
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/server && npm run build -w packages/client",
    "build:shared": "npm run build -w packages/shared",
    "build:server": "npm run build -w packages/server",
    "build:client": "npm run build -w packages/client",
    "start": "npm run start -w packages/server",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w packages/shared && npm run test -w packages/server && npm run test -w packages/client",
    "test:unit": "npm run test -w packages/shared && npm run test -w packages/client",
    "test:integration": "npm run test -w packages/server",
    "test:security": "npm run test:security -w packages/server",
    "test:observability": "npm run test:observability -w packages/server",
    "test:property": "node scripts/ci/property-gate.mjs",
    "test:fuzz": "node scripts/ci/fuzz-gate.mjs",
    "test:resource": "node scripts/ci/resource-gate.mjs",
    "test:storage": "node scripts/ci/storage-gate.mjs",
    "test:upgrade": "node scripts/ci/upgrade-gate.mjs",
    "test:recovery": "node scripts/ci/recovery-gate.mjs",
    "test:flake": "node scripts/ci/flake-run.mjs",
    "test:flake:e2e": "npx playwright test --config playwright.flake.config.ts",
    "test:dst": "node scripts/ci/dst-gate.mjs",
    "test:mutation": "node scripts/ci/mutation-gate.mjs",
    "test:mutation:diff": "node scripts/ci/mutation-diff-gate.mjs",
    "test:smoke": "node scripts/ci/smoke-gate.mjs",
    "test:sandbox": "node --import tsx scripts/ci/sandbox-gate.mjs",
    "test:deploy": "node scripts/ci/deploy-drill.mjs",
    "test:snapshot": "npm run test:snapshot -w packages/client",
    "test:a11y": "node scripts/ci/a11y-gate.mjs",
    "test:e2e": "npx playwright test",
    "type-check": "npm run type-check -w packages/shared && npm run type-check -w packages/server && npm run type-check -w packages/client && npm run type-check:e2e",
    "type-check:e2e": "tsc -p tsconfig.e2e.json",
    "audit:prod": "npm audit --audit-level=moderate --omit=dev",
    "secret-scan": "node scripts/ci/secret-scan.mjs",
    "ci": "node scripts/ci/local-ci.mjs",
    "ci:list": "node scripts/ci/local-ci.mjs --list",
    "ci:docker": "node scripts/ci/docker-gate.mjs",
    "ci:sast": "node scripts/ci/sast-gate.mjs",
    "verify:fast": "node scripts/ci/local-ci.mjs --tier=0",
    "verify:full": "node scripts/ci/local-ci.mjs --tier=full",
    "ci:local": "node scripts/ci/clean-room.mjs",
    "verify:selftest": "node scripts/ci/selftest.mjs",
    "audit:integrity": "node scripts/ci/integrity-scan.mjs",
    "audit:ratchet": "node scripts/ci/ratchet-check.mjs --tier 0",
    "audit:ratchet:full": "npm run report && node scripts/ci/ratchet-check.mjs",
    "coverage:check": "node scripts/ci/coverage-check.mjs",
    "lint:report": "node scripts/ci/lint-gate.mjs",
    "report": "node scripts/ci/report.mjs",
    "release:next-version": "node scripts/ci/next-version.mjs",
    "clean": "rimraf packages/*/dist packages/client/dist-sandbox packages/*/node_modules node_modules logs .cache/tsbuildinfo packages/shared/tsconfig.tsbuildinfo packages/client/tsconfig.tsbuildinfo",
    "prepare": "husky",
    "deadcode": "node scripts/ci/deadcode-gate.mjs",
    "deadcode:duplication": "jscpd --config .jscpd.json",
    "audit:config": "node scripts/ci/config-gate.mjs",
    "audit:openapi": "node scripts/ci/openapi-gate.mjs",
    "audit:config:openapi": "spectral lint .testfortress/reports/openapi.json --ruleset .spectral.yaml --format json --fail-severity error --quiet",
    "audit:licenses": "node scripts/ci/license-gate.mjs",
    "audit:bundle": "node scripts/ci/bundle-gate.mjs",
    "audit:secrets": "node scripts/ci/secret-scan.mjs --report",
    "audit:secrets:full": "node scripts/ci/secret-scan.mjs --all --history --report",
    "deadcode:unused": "knip --reporter json"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{mjs,cjs,js}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "follow-redirects": "^1.16.0",
    "lodash": ">=4.17.24",
    "path-to-regexp": ">=8.3.1",
    "picomatch": ">=2.3.2",
    "postcss": "^8.5.23",
    "qs": ">=6.16.0",
    "serialize-javascript": ">=7.0.5",
    "shell-quote": ">=1.9.0",
    "underscore": "1.13.8",
    "yaml": ">=2.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@stoplight/spectral-cli": "^6.16.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/instrumenter": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.1",
    "knip": "^6.37.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.5.1",
    "mongodb": "^7.6.0",
    "mongodb-memory-server": "^11.3.0",
    "otpauth": "^9.5.2",
    "prettier": "^3.9.8",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "argon2": false,
    "esbuild@0.28.1": true,
    "mongodb-memory-server@11.3.0": true
  },
  "scarfSettings": {
    "enabled": false
  }
}
